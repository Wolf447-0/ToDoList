<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="60dp"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/title_edit_fragment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Edit the record:"
        android:textSize="25sp"
        android:layout_marginLeft="@dimen/MarginLeft"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        />

    <TextView
        android:id="@+id/for_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/MarginLeft"

        android:text="Title:"
        android:textColor="#616060"
        android:textSize="20sp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/title_edit_fragment"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"

        />

    <EditText
        android:id="@+id/input_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/MarginLeft"
        android:hint="введите новое название"
        app:layout_constraintTop_toBottomOf="@+id/for_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"

        />

    <TextView
        android:id="@+id/for_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/MarginLeft"

        android:layout_marginTop="20dp"

        android:text="Text:"
        android:textColor="#616060"
        android:textSize="20sp"

        app:layout_constraintTop_toBottomOf="@+id/input_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"

        />

    <EditText
        android:id="@+id/input_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/MarginLeft"
        android:hint="введите новое содержание"
        app:layout_constraintTop_toBottomOf="@+id/for_text"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"

        />

    <Button
        android:id="@+id/change_record"
        android:layout_width="70dp"
        android:layout_height="70dp"

        style="@style/BtnAddNewRecord"

        android:layout_marginBottom="10dp"
        android:layout_marginRight="10dp"

        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>